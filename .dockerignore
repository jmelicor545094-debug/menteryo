# Version control
.git
.gitattributes
.gitignore

# Dependencies (rebuilt inside the container)
vendor
node_modules

# Environment files (set via Render dashboard)
.env
.env.backup
.env.production

# IDE / Editor
.idea
.vscode
*.swp
*.swo
.editorconfig

# OS files
Thumbs.db
.DS_Store

# Testing
tests
phpunit.xml
.phpunit.result.cache

